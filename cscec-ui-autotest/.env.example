# ──────────────────────────────────────────────
# 中建云 UI 自动化测试 — 环境配置模板
# 复制此文件为 .env 并填入实际值
# ──────────────────────────────────────────────

# 环境：uat / pre / prod
ENV=uat

# 登录凭证
USERNAME=<账号>
PASSWORD=<兼容兜底密码，可留空>
UAT_PASSWORD=<UAT 密码>
PRE_PASSWORD=<PRE 密码>
PROD_PASSWORD=<PROD 密码>

# 域名拆分 URL。未配置时会回退到 config/environments.py 的兼容默认值。
UAT_CONSOLE_BASE_URL=https://irp-uat.cscec.com/
UAT_PORTAL_BASE_URL=https://cloud-uat.cscec.com/
UAT_WORKBENCH_BASE_URL=https://cloud-uat.cscec.com/
UAT_MOBILE_BASE_URL=https://cloud-uat.cscec.com/
PRE_CONSOLE_BASE_URL=https://irp-pre.cscec.com/
PRE_PORTAL_BASE_URL=https://cloud-pre.cscec.com/
PRE_WORKBENCH_BASE_URL=https://cloud-pre.cscec.com/
PRE_MOBILE_BASE_URL=https://cloud-pre.cscec.com/
PROD_CONSOLE_BASE_URL=https://irp.cscec.com/
PROD_PORTAL_BASE_URL=https://cloud.cscec.com/
PROD_WORKBENCH_BASE_URL=https://cloud.cscec.com/
PROD_MOBILE_BASE_URL=https://cloud.cscec.com/
PROD_DOC_CENTER_URL=https://cloud.cscec.com/udpweb/portal/index.html#/portal/home/workbench?suitKey=1899427585366003724&mc=1899427585366003724&mn=%E6%96%87%E6%A1%A3%E4%B8%AD%E5%BF%83&mt=module&appTitle=%E5%B7%A5%E4%BD%9C%E5%8F%B0
PROD_DOC_CENTER_FALLBACK_URL=https://irp.cscec.com/udpweb/portal/index.html#/portal/home/workbench?suitKey=1899427585366003724&mc=1899427585366003724&mn=%E6%96%87%E6%A1%A3%E4%B8%AD%E5%BF%83&mt=module&appTitle=%E5%B7%A5%E4%BD%9C%E5%8F%B0

# 控制台深链。PRE 若与 UAT/PROD 的 suitKey/menuCode 不一致，可在 .env 中覆盖。
# 示例：PRE_DATA_RESOURCE_ROUTE=/udpweb/portal/index.html?loginType=1&#/sub/resource/resource/dataResources?...
# 示例：PRE_LAYER_SETTINGS_ROUTE=/udpweb/portal/index.html?#/sub/resource/systemManage/layerSet?...

# 域名拆分门户样本。UAT/PRE 写入类需要显式打开 RUN_PORTAL_WRITE_CASES。
PORTAL_EXPECTED_TENANT=中建云
RUN_PORTAL_WRITE_CASES=false

# 浏览器
HEADLESS=true
SLOW_MO=0
BROWSER_CHANNEL=chrome

# 超时（毫秒）
NAVIGATION_TIMEOUT=60000
ACTION_TIMEOUT=15000
DEFAULT_TIMEOUT=5000

# 重试
NETWORK_RETRY_MAX=3
NETWORK_RETRY_BASE_DELAY=30
